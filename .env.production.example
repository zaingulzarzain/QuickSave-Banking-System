# Production .env — copy to .env and fill securely
# Generate SECRET_KEY with: openssl rand -hex 32

# ---- Core ----
DATABASE_URL=sqlite:////app/data/quicksave.db
# For Postgres (Render/Railway/Fly managed):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/quicksave

SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=*
SEED_DEMO_DATA=true

# ---- AI (optional — leave empty for offline mode which always works) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=true

# ---- Server ----
PORT=8000
