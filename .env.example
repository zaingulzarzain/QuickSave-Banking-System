# ---- QuickSave configuration (copy to .env and adjust) ----

# Database — SQLite by default (zero setup). For Postgres:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/quicksave
DATABASE_URL=sqlite:///./quicksave.db

# Auth — CHANGE THIS in production!
SECRET_KEY=dev-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS ("*" for demos, or comma-separated origins)
CORS_ORIGINS=*

# Seed demo users/transactions on first launch
SEED_DEMO_DATA=true

# ---- AI / LLM (OpenAI-compatible, optional) ----
# Leave OPENAI_API_KEY empty to use the built-in rule-based AI fallback (works offline).
# Point OPENAI_BASE_URL at OpenAI, Azure OpenAI, Ollama, LM Studio, vLLM, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=true
